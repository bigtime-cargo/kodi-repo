<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.o2tv" name="O2 TV SK" version="1.1.20" provider-name="matus">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="inputstream.adaptive" version="20.0.0"/>
    <import addon="script.module.requests" version="2.22.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="sk">O2 TV SK</summary>
    <platform>all</platform>
  </extension>
</addon>
<addon id="repository.bigtime" name="BigTime Kodi repo" version="1.0.0" provider-name="matus">
  <extension point="xbmc.addon.repository" name="BigTime">
    <dir>
      <info compressed="false">https://bigtime-cargo.github.io/kodi-repo/addons.xml</info>
      <checksum>https://bigtime-cargo.github.io/kodi-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://bigtime-cargo.github.io/kodi-repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="sk">Repozitár s doplnkom O2 TV SK</summary>
    <platform>all</platform>
  </extension>
</addon>
<addon id="service.sc.keepalive" name="SC keep-alive" version="1.0.0" provider-name="matus">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Keeps the Stream Cinema helper session alive during long playback.</summary>
    <summary lang="sk_SK">Udrží session helpera Stream Cinema pri dlhom prehrávaní, aby epizóda po 30 minútach nespadla.</summary>
    <description lang="sk_SK">service.sc.helper zahodí session 30 minút po poslednom HTTP requeste a nepretržité prehrávanie je jeden request. Reconnect po pauze alebo timeoute potom dostane 404 a prehrávanie skončí. Tento doplnok počas prehrávania z helpera pošle každých 10 minút request na 1 bajt, čím session obnoví.</description>
    <platform>all</platform>
    <license>GPL-3.0-or-later</license>
  </extension>
</addon>
</addons>
