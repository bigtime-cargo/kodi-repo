<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
  <section id="service.bigtime.streamlet">
    <category id="general" label="Streamlet">
      <group id="1">
        <setting id="playlist_url" type="string" label="URL playlistu">
          <level>0</level>
          <default>https://repo.streamlet.info/playlists/cz.m3u</default>
          <control type="edit" format="string"><heading>URL playlistu</heading></control>
        </setting>
        <setting id="epg_url" type="string" label="URL EPG (zdroj stiahnutia; v novej inštancii bez lokálnej kópie)">
          <level>0</level>
          <default>https://www.open-epg.com/files/czech.xml</default>
          <control type="edit" format="string"><heading>URL EPG</heading></control>
        </setting>
        <setting id="epg_local" type="boolean" label="Sťahovať EPG sám a čítať ho z lokálneho súboru (open-epg.com má limit 20 stiahnutí denne)">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="epg_hours" type="integer" label="Obnova EPG po (hodín)">
          <level>0</level>
          <default>12</default>
          <constraints><minimum>1</minimum><step>1</step><maximum>168</maximum></constraints>
          <control type="spinner" format="integer"/>
        </setting>
        <setting id="dedupe_o2" type="boolean" label="Vynechať kanály, ktoré už má O2 TV (O2 má archív)">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="groups" type="boolean" label="Zaradiť kanály do skupín podľa témy a očíslovať">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="chno_start" type="integer" label="Prvé číslo kanála (O2 TV má 1-99)">
          <level>0</level>
          <default>101</default>
          <constraints><minimum>1</minimum><step>1</step><maximum>9000</maximum></constraints>
          <control type="spinner" format="integer"/>
        </setting>
        <setting id="hide_no_epg" type="boolean" label="Skryť kanály, ktoré nemajú EPG (podľa lokálnej kópie EPG)">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="refresh_hours" type="integer" label="Obnova playlistu po (hodín)">
          <level>0</level>
          <default>12</default>
          <constraints><minimum>1</minimum><step>1</step><maximum>168</maximum></constraints>
          <control type="spinner" format="integer"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
